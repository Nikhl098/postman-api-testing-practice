              "pm.test(\"TC05: lastname is Singh\", function () { pm.expect(Boolean(json && json.lastname === 'Singh')).to.be.true; });",
              "pm.test(\"TC05: depositpaid is true\", function () { pm.expect(Boolean(json && json.depositpaid === true)).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC06 - Get booking ids - filter by lastname",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking?lastname=Singh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ],
          "query": [
            {
              "key": "lastname",
              "value": "Singh"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = null; try { json = pm.response.json(); } catch (e) {}",
              "const text = pm.response.text();",
              "pm.test(\"TC06: Status is 200\", function () { pm.expect(Boolean(code === 200)).to.be.true; });",
              "pm.test(\"TC06: Response is an array\", function () { pm.expect(Boolean(Array.isArray(json))).to.be.true; });",
              "pm.test(\"TC06: Every item has bookingid\", function () { pm.expect(Boolean(Array.isArray(json) && json.every(x => typeof x.bookingid === 'number'))).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
