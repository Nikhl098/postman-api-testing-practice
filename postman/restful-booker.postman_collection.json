{
  "info": {
    "name": "Restful Booker - API testing practice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Practice collection for the public Restful Booker API. Run requests in order (folder Run). Author: Nikhil Pratap Singh."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://restful-booker.herokuapp.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "TC01 - Health check - GET /ping",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ping"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = null; try { json = pm.response.json(); } catch (e) {}",
              "const text = pm.response.text();",
              "pm.test(\"TC01: Status is 201 (Created)\", function () { pm.expect(Boolean(code === 201)).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC02 - Create token - valid credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = null; try { json = pm.response.json(); } catch (e) {}",
              "const text = pm.response.text();",
              "pm.test(\"TC02: Status is 200\", function () { pm.expect(Boolean(code === 200)).to.be.true; });",
              "pm.test(\"TC02: Response has a token\", function () { pm.expect(Boolean(json && typeof json.token === 'string' && json.token.length > 0)).to.be.true; });",
              "pm.collectionVariables.set(\"token\", json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "TC03 - Create token - wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = null; try { json = pm.response.json(); } catch (e) {}",
              "const text = pm.response.text();",
              "pm.test(\"TC03: Status is 200 (API returns 200 even for bad login)\", function () { pm.expect(Boolean(code === 200)).to.be.true; });",
              "pm.test(\"TC03: Body says Bad credentials\", function () { pm.expect(Boolean(json && json.reason === 'Bad credentials')).to.be.true; });",
              "pm.test(\"TC03: No token returned\", function () { pm.expect(Boolean(json && !json.token)).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC04 - Create booking - valid data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Nikhil\",\n  \"lastname\": \"Singh\",\n  \"totalprice\": 500,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const code = pm.response.code;",
              "let json = null; try { json = pm.response.json(); } catch (e) {}",
              "const text = pm.response.text();",
              "pm.test(\"TC04: Status is 200\", function () { pm.expect(Boolean(code === 200)).to.be.true; });",
              "pm.test(\"TC04: bookingid is a number\", function () { pm.expect(Boolean(json && typeof json.bookingid === 'number')).to.be.true; });",
              "pm.test(\"TC04: firstname saved correctly\", function () { pm.expect(Boolean(json && json.booking.firstname === 'Nikhil')).to.be.true; });",
              "pm.test(\"TC04: totalprice saved correctly\", function () { pm.expect(Boolean(json && json.booking.totalprice === 500)).to.be.true; });",
              "pm.test(\"TC04: checkin date saved correctly\", function () { pm.expect(Boolean(json && json.booking.bookingdates.checkin === '2026-11-01')).to.be.true; });",
              "pm.collectionVariables.set(\"bookingId\", json.bookingid);"
            ]
          }
        }
      ]
    },
    {
      "name": "TC05 - Get booking by id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
