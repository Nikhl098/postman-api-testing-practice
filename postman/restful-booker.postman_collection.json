              "pm.test(\"TC07: lastname changed to Pratap\", function () { pm.expect(Boolean(json && json.lastname === 'Pratap')).to.be.true; });",
              "pm.test(\"TC07: totalprice changed to 650\", function () { pm.expect(Boolean(json && json.totalprice === 650)).to.be.true; });"
            ]
          }
        }
      ]
    },
